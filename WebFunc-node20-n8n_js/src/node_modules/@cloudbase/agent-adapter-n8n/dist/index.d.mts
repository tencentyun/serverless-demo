import { AbstractAgent, AgentConfig, RunAgentInput, BaseEvent } from '@ag-ui/client';
import { Observable } from 'rxjs';
import { Logger } from '@cloudbase/agent-shared';
export { Logger, createConsoleLogger, noopLogger } from '@cloudbase/agent-shared';

/**
 * Request configuration for n8n webhook calls
 */
interface N8nRequestConfig {
    /** Request timeout in milliseconds (default: 120000) */
    timeout?: number;
    /** Additional headers to send with the request */
    headers?: Record<string, string>;
}
/**
 * n8n adapter configuration
 *
 * @example
 * ```typescript
 * // Use environment variables (N8N_WEBHOOK_URL)
 * const agent = new N8nAgent();
 *
 * // Or explicit configuration with Basic Auth
 * const agent = new N8nAgent({
 *   webhookUrl: "https://n8n.example.com/webhook/chat",
 *   request: {
 *     headers: { Authorization: `Basic ${Buffer.from("user:pass").toString("base64")}` }
 *   }
 * });
 * ```
 */
interface N8nConfig {
    /**
     * n8n Webhook URL.
     * Falls back to N8N_WEBHOOK_URL environment variable if not provided.
     */
    webhookUrl?: string;
    /** Request configuration */
    request?: N8nRequestConfig;
}
/**
 * n8n webhook request body
 * Only includes fields that n8n Chat Trigger actually consumes.
 */
interface N8nRequestBody {
    /** User input text for the n8n Chat Trigger */
    chatInput: string;
    /** Session ID for maintaining conversation context in n8n Memory nodes */
    sessionId: string;
}
/**
 * Context for stream processing
 */
interface StreamContext {
    threadId: string;
    runId: string;
    messageId: string;
}

declare class N8nAgentError extends Error {
    code?: string;
    constructor(message: string, code?: string);
}
/**
 * n8n Agent Adapter
 *
 * Connects to n8n workflows via Streaming Webhook.
 * Supports basic text streaming (TEXT_MESSAGE_* events only).
 * Tool calls are handled internally within the n8n workflow.
 *
 * Environment Variables:
 * - N8N_WEBHOOK_URL: n8n webhook URL (required if not provided in config)
 *
 * @example
 * ```typescript
 * // Using environment variables
 * // N8N_WEBHOOK_URL=https://n8n.example.com/webhook/chat
 * const agent = new N8nAgent();
 *
 * // Or explicit configuration with Basic Auth
 * const agent = new N8nAgent({
 *   n8nConfig: {
 *     webhookUrl: "https://n8n.example.com/webhook/chat",
 *     request: {
 *       headers: { Authorization: `Basic ${Buffer.from("user:pass").toString("base64")}` }
 *     }
 *   }
 * });
 *
 * agent.run({
 *   threadId: "thread-xxx",
 *   runId: "run-xxx",
 *   messages: [{ role: "user", content: "Hello" }]
 * }).subscribe(event => {
 *   console.log(event);
 * });
 * ```
 */
declare class N8nAgent extends AbstractAgent {
    protected n8nConfig: Required<Pick<N8nConfig, "webhookUrl">> & N8nConfig;
    private logger;
    constructor(config?: AgentConfig & {
        n8nConfig?: N8nConfig;
        logger?: Logger;
    });
    /**
     * Extract parent SpanContext from AG-UI server's forwardedProps.
     * Returns undefined if not available (observability will create a new root trace).
     */
    private _extractParentSpanContext;
    /**
     * Run the agent with n8n webhook streaming
     */
    run(input: RunAgentInput): Observable<BaseEvent>;
    private _runWithObservability;
    private _run;
    /**
     * Process the HTTP stream and emit AGUI events
     * Parses n8n JSON Lines format and maps "item" type content to TEXT_MESSAGE_* events
     * Also handles <think>...</think> tags to emit THINKING_* events
     *
     * N8n returns JSON Lines format:
     * - {"type": "begin", "metadata": {...}}
     * - {"type": "item", "content": "...", "metadata": {...}}
     * - {"type": "end", "metadata": {...}}
     *
     * Think content is wrapped in <think>...</think> tags and may span multiple items.
     * Example:
     *   item1: "<think>\n用户要求"
     *   item2: "思考内容</think>\n\n正式回答"
     */
    private processTextStream;
    /**
     * Process a content chunk and emit appropriate events based on <think> tags
     */
    private processContentChunk;
    /**
     * Close any open parse states at the end of stream
     */
    private closeParseState;
}

/**
 * Generate a unique run ID
 */
declare function generateRunId(): string;
/**
 * Generate a unique thread ID
 */
declare function generateThreadId(): string;

export { N8nAgent, N8nAgentError, type N8nConfig, type N8nRequestBody, type N8nRequestConfig, type StreamContext, generateRunId, generateThreadId };
