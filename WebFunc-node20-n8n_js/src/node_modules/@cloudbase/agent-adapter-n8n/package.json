{
  "name": "@cloudbase/agent-adapter-n8n",
  "version": "0.0.21",
  "description": "n8n adapter for AG-Kit - Connect to n8n workflows via Streaming Webhook",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "ag-kit",
    "n8n",
    "adapter",
    "llm",
    "workflow",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.42",
    "rxjs": "^7.8.1",
    "@cloudbase/agent-shared": "^0.0.21",
    "@cloudbase/agent-observability": "^0.0.21"
  },
  "peerDependencies": {
    "@cloudbase/agent-observability": "0.0.21"
  },
  "peerDependenciesMeta": {
    "@cloudbase/agent-observability": {
      "optional": true
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup --config tsup.config.ts"
  }
}